# Cours du jour : configuration Apache (IONOS, OVH, o2switch…)
# (Pas de directive « Options » : refusée par certains hébergeurs, dont IONOS → erreur 500)
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forcer HTTPS (activer le certificat SSL du domaine dans l'espace client avant de décommenter)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Dossiers privés : jamais accessibles depuis le web
  RewriteRule ^(data|lib)(/|$) - [F,L]
  RewriteRule ^config(\.sample)?\.php$ - [F,L]

  # Fichiers statiques existants (écran, polices, logo, CSS/JS admin) : servis directement
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Tout le reste (écrans, API, back-office) -> index.php
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Robots-Tag "noindex, nofollow"
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(ttf|woff2|png)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType font/ttf .ttf
  AddType font/woff2 .woff2
</IfModule>
