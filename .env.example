# --- Serveur ---
NODE_ENV=production
PORT=3000
# Fuseau horaire de référence pour l'affichage
TZ_DISPLAY=Europe/Paris
# Derrière un reverse proxy HTTPS (Nginx, Caddy, Traefik…) : mettre 1
TRUST_PROXY=1
# En local sur le réseau de l'école SANS HTTPS : mettre false (sinon la connexion admin ne tient pas)
COOKIE_SECURE=

# --- Back-office ---
ADMIN_USER=peda-montpellier
# Généré avec : npm run hash-password   (entourer de guillemets simples, le hash contient des $)
ADMIN_PASSWORD_HASH=
# Chaîne aléatoire d'au moins 32 caractères : openssl rand -hex 32
SESSION_SECRET=
# Clé de chiffrement de la clé API HyperPlanning stockée sur disque. openssl rand -hex 32
# Ne JAMAIS la changer après avoir saisi la clé API (sinon il faudra la ressaisir).
SECRETS_KEY=
# (Optionnel) Clé API HyperPlanning fournie directement au serveur. Si renseignée, elle est
# prioritaire et n'a pas besoin d'être saisie dans le back-office.
HP_API_KEY=
# (Optionnel) N'autoriser le back-office que depuis le réseau de l'école. Ex : 10.0.*,192.168.1.*
ADMIN_ALLOWED_IPS=

# --- Écrans ---
# (Optionnel mais recommandé) Clé ajoutée aux URL d'écran (?key=...) pour que le planning
# ne soit pas consultable par n'importe qui sur Internet. openssl rand -hex 16
DISPLAY_KEY=
# Domaines autorisés à intégrer l'écran en iframe (widget « Site web » d'Emity).
# Laisser vide = tous. Ex : https://*.emity.io
DISPLAY_FRAME_ANCESTORS=
